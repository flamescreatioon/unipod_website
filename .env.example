# Use Neon’s pooled connection URL for the running API.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Use Neon’s direct (non-pooler) connection URL only for migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require

# Optional. Comma-separated origins allowed to call the API when it is hosted
# separately from the frontend. A same-origin Vercel deployment needs no value.
CONTACT_APP_ORIGIN=http://localhost:5173

# Optional when the frontend and API are deployed on different origins.
VITE_CONTACT_API_URL=

# Set the actual public website origin to enable canonical URLs and a sitemap.
VITE_SITE_URL=

# Sanity frontend connection (public values; do not put tokens in VITE_ variables).
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_STUDIO_URL=
